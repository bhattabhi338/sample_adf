{
	"name": "Landing_Path",
	"properties": {
		"linkedServiceName": {
			"referenceName": "Data_Lake",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"FileName": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().FileName",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat(\n    'landing_files/',\n    formatDateTime(utcNow(),'yyyy-MM-dd'),\n    '/'\n)",
					"type": "Expression"
				},
				"fileSystem": "my-first-container"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}