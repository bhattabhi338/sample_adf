{
	"name": "Landing_File",
	"properties": {
		"linkedServiceName": {
			"referenceName": "Data_Lake",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"File_Name": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Parquet",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"folderPath": {
					"value": "@concat(\r\n    'landing_files/',\r\n    formatDateTime(utcNow(),'yyyyMMdd'),\r\n    '/',\r\n    dataset().File_Name\r\n)",
					"type": "Expression"
				},
				"fileSystem": "my-first-container"
			},
			"compressionCodec": "snappy"
		},
		"schema": []
	}
}